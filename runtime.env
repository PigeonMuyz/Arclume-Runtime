# Product-owned runtime identity. Wine and CrossOver source versions stay in
# sources/WINE_SOURCE.lock; neither is used as the Arclume release number.
RUNTIME_ID="io.arclume.runtime.wine"
RUNTIME_DISPLAY_NAME="Arclume Wine"
RUNTIME_VERSION="1.0.0"
RUNTIME_CHANNEL="stable"
RUNTIME_ABI="1"
PREFIX_ABI="arclume-jx3-prefix-1"
RUNTIME_ARCHITECTURE="x86_64"
RUNTIME_MINIMUM_MACOS="26.0"
# A prior embedded runtime can be atomically renamed in Application Support.
# It is a migration input, never a user-facing runtime version.
LEGACY_INSTALL_MARKER="wine-11.0-procyon.7"
LEGACY_INSTALL_ROOT="procyon-wine-runtime-x86_64-v8-mono-d3dmetal4-zhcn"
